/* Hello Reader メニュー仕様書 (nadesiko3) */
# 対象コンポーネントは、「com.stomato.helloreader.HelloReaderService」。
# メニューマネージャーは、「com.stomato.helloreader.menu.HelloReaderMenuManager」。

# ==============================================================================
# 1. ジェスチャー定義と目的
# ==============================================================================
# 【トリガー】
# TalkBack標準直角ジェスチャー：下にスワイプしてから右へスワイプ (GESTURE_SWIPE_DOWN_AND_RIGHT)
# 互換トリガー：上にスワイプしてから右へスワイプ (GESTURE_SWIPE_UP_AND_RIGHT)
#
# 【目的】
# 画面上のどこからでも、連続読み上げ、直前音声の確認・コピー、フィードバック切り替え、
# 点字ディスプレイ・モールス信号・点字触覚フィードバック、TTS・アプリ設定などを素早く呼び出せるグローバルコンテキストメニューを提供する。

# ==============================================================================
# 2. メニュー起動処理（ガード節と安全な起動）
# ==============================================================================
●(ジェスチャーIDで)メニュー起動判定処理とは
	# 【ガード1】直角ジェスチャー（下→右 または 上→右）以外は無視して終了
	もし、(ジェスチャーID != 「GESTURE_SWIPE_DOWN_AND_RIGHT」)かつ(ジェスチャーID != 「GESTURE_SWIPE_UP_AND_RIGHT」)ならば
		戻る
	ここまで

	# 【ガード2】現在すでにメニューが表示されている場合は重複表示を防止
	もし、メニュー表示中フラグ == 真ならば
		戻る
	ここまで

	# 音声出力を即時中断してフォーカス音を再生
	# - 音声を即時中断
	# - フォーカス音を再生
	# - 「Hello Reader メニュー」を発声
	「Hello Reader メニュー」を表示
	メニュー構築処理
ここまで

# ==============================================================================
# 3. メニュー項目定義（TalkBack context_menu.xml 準拠 ＋ hello-reader独自機能）
# ==============================================================================
●メニュー項目一覧定義とは
	項目リスト = []

	# --- グループ1: 連続読み上げ ---
	項目リスト[要素数(項目リスト)] = {"id": "read_from_top", "order": 8, "title": "最上部から読み上げる", "action": "最上部から連続読み上げ", "allowLocked": 偽}
	項目リスト[要素数(項目リスト)] = {"id": "read_from_current", "order": 9, "title": "フォーカスした項目から読み上げ", "action": "現在位置から連続読み上げ", "allowLocked": 偽}

	# --- グループ2: 直前フレーズの操作 ---
	項目リスト[要素数(項目リスト)] = {"id": "copy_last_utterance", "order": 10, "title": "最後に読み上げたフレーズをコピー", "action": "直前テキストクリップボード保存", "allowLocked": 偽}
	項目リスト[要素数(項目リスト)] = {"id": "spell_last_utterance", "order": 11, "title": "最後に読み上げたフレーズのスペルを確認", "action": "直前テキストスペル詳細読み", "allowLocked": 真}
	項目リスト[要素数(項目リスト)] = {"id": "repeat_last_utterance", "order": 12, "title": "最後に読み上げたフレーズを繰り返す", "action": "直前テキスト再発声", "allowLocked": 真}

	# --- グループ3: 画面操作・テキスト編集 ---
	もし、現在フォーカスノードカスタムアクション == 真ならば
		項目リスト[要素数(項目リスト)] = {"id": "custom_actions", "order": 2, "title": "操作（アクション）", "action": "カスタムアクションメニュー表示", "allowLocked": 偽}
	ここまで
	項目リスト[要素数(項目リスト)] = {"id": "screen_search", "order": 19, "title": "画面検索", "action": "画面内テキスト検索起動", "allowLocked": 偽}

	# --- グループ4: クイック設定・フィードバック切り替え ---
	項目リスト[要素数(項目リスト)] = {"id": "audio_ducking", "order": 16, "title": "他の音量を下げる", "action": "オーディオダッキング切替", "allowLocked": 真}
	項目リスト[要素数(項目リスト)] = {"id": "sound_feedback", "order": 17, "title": "音によるフィードバック", "action": "効果音フィードバック切替", "allowLocked": 真}
	項目リスト[要素数(項目リスト)] = {"id": "vibration_feedback", "order": 18, "title": "バイブ フィードバック", "action": "振動フィードバック切替", "allowLocked": 真}
	
	# --- hello-reader独自：点字・モールス触覚フィードバックON/OFF切り替え ---
	項目リスト[要素数(項目リスト)] = {"id": "braille_display_toggle", "order": 30, "title": "点字ディスプレイ ON/OFF", "action": "点字ディスプレイ出力切替", "allowLocked": 真}
	項目リスト[要素数(項目リスト)] = {"id": "morse_feedback_toggle", "order": 31, "title": "モールス信号フィードバック ON/OFF", "action": "モールス信号フィードバック切替", "allowLocked": 真}
	項目リスト[要素数(項目リスト)] = {"id": "braille_haptic_toggle", "order": 32, "title": "点字フィードバック ON/OFF", "action": "6点点字パルス振動切替", "allowLocked": 真}

	もし、画面暗転中フラグ == 真ならば
		項目リスト[要素数(項目リスト)] = {"id": "screen_curtain", "order": 20, "title": "画面を表示（スクリーンカーテン解除）", "action": "画面表示復元", "allowLocked": 真}
	違えば
		項目リスト[要素数(項目リスト)] = {"id": "screen_curtain", "order": 20, "title": "画面を隠す（スクリーンカーテン）", "action": "画面暗転実行", "allowLocked": 真}
	ここまで

	# --- グループ5: 設定画面起動 ---
	項目リスト[要素数(項目リスト)] = {"id": "verbosity", "order": 13, "title": "読み上げの詳細設定", "action": "詳細度設定画面起動", "allowLocked": 偽}
	項目リスト[要素数(項目リスト)] = {"id": "tts_settings", "order": 24, "title": "テキスト読み上げ", "action": "OS標準TTS設定起動", "allowLocked": 偽}
	項目リスト[要素数(項目リスト)] = {"id": "braille_display_settings", "order": 25, "title": "点字ディスプレイの設定", "action": "点字ディスプレイ設定起動", "allowLocked": 偽}
	項目リスト[要素数(項目リスト)] = {"id": "helloreader_settings", "order": 23, "title": "Hello Reader の設定", "action": "メイン設定画面起動", "allowLocked": 偽}

	項目リストを戻す
ここまで

# ==============================================================================
# 4. メニュー構築と表示処理（セキュリティ・画面ロック考慮）
# ==============================================================================
●メニュー構築処理とは
	全項目 = メニュー項目一覧定義
	表示項目リスト = []
	# 画面ロック状態はKeyguardManagerより取得

	# ロック画面での情報保護ガード：ロック中は許可された項目のみ抽出
	対象項目で全項目を反復
		もし、(画面ロック状態 == 真)かつ(対象項目["allowLocked"] == 偽)ならば
			続ける
		ここまで
		表示項目リスト[要素数(表示項目リスト)] = 対象項目
	ここまで

	# 順序（order）でソート
	# 表示項目リストを表示順序で昇順ソート

	# アクセシビリティオーバーレイダイアログとして画面に表示
	# オーバーレイダイアログに表示項目リストを設定
	メニュー表示中フラグ = 真
	# 先頭のメニュー項目にアクセシビリティフォーカスを設定
ここまで

# ==============================================================================
# 5. メニュー項目選択時のアクション実行処理（TalkBack ClickProcessor 準拠）
# ==============================================================================
●(選択項目IDで)メニューアクション実行とは
	# 【ガード】選択項目IDが空またはNullならば終了
	もし、選択項目ID == 「」ならば
		# メニューを閉じる
		戻る
	ここまで

	# メニューを閉じる
	メニュー表示中フラグ = 偽

	# 項目IDごとの分岐実行
	もし、選択項目ID == 「read_from_top」ならば
		「最上部から読み上げます」を表示
		# 画面アクティブルートの先頭ノードを探索しフォーカス移動後、連続読み上げモードを開始
	違えば、もし、選択項目ID == 「read_from_current」ならば
		# 現在フォーカスノードから連続読み上げモードを開始
	違えば、もし、選択項目ID == 「copy_last_utterance」ならば
		もし、直前読み上げテキスト != 「」ならば
			# クリップボードに直前読み上げテキストをコピー
			「直前に読み上げたフレーズをクリップボードにコピーしました」を表示
		違えば
			「コピーできる読み上げフレーズがありません」を表示
		ここまで
	違えば、もし、選択項目ID == 「spell_last_utterance」ならば
		もし、直前読み上げテキスト != 「」ならば
			# 直前読み上げテキストを1文字ずつ詳細フォネティック読み上げ
			「詳細読み上げ実行」を表示
		違えば
			「確認できる読み上げフレーズがありません」を表示
		ここまで
	違えば、もし、選択項目ID == 「repeat_last_utterance」ならば
		もし、直前読み上げテキスト != 「」ならば
			# 直前読み上げテキストを再発声
			「再発声」を表示
		違えば
			「リピートできる読み上げフレーズがありません」を表示
		ここまで
	違えば、もし、選択項目ID == 「custom_actions」ならば
		# 現在ノードの利用可能なカスタムアクション一覧をダイアログ表示
	違えば、もし、選択項目ID == 「screen_search」ならば
		# 画面検索用テキスト入力ダイアログを表示
	違えば、もし、選択項目ID == 「audio_ducking」ならば
		# ダッキング設定＝オーディオダッキング設定反転
		「他の音量を下げる設定を切替」を表示
	違えば、もし、選択項目ID == 「sound_feedback」ならば
		# サウンド設定＝音フィードバック設定反転
		「効果音フィードバックを切替」を表示
	違えば、もし、選択項目ID == 「vibration_feedback」ならば
		# バイブ設定＝バイブレーション設定反転
		「バイブレーションを切替」を表示
	違えば、もし、選択項目ID == 「braille_display_toggle」ならば
		# 点字ディスプレイ設定＝点字ディスプレイ接続設定反転
		「点字ディスプレイ出力を切替」を表示
	違えば、もし、選択項目ID == 「morse_feedback_toggle」ならば
		# モールス設定＝モールス信号設定反転
		「モールス信号フィードバックを切替」を表示
	違えば、もし、選択項目ID == 「braille_haptic_toggle」ならば
		# 点字振動設定＝点字触覚振動設定反転
		「点字触覚フィードバックを切替」を表示
	違えば、もし、選択項目ID == 「screen_curtain」ならば
		もし、画面暗転中フラグ == 真ならば
			# 画面の暗転オーバーレイを解除
			画面暗転中フラグ = 偽
			「画面を表示しました」を表示
		違えば
			# 画面全体に黒色オーバーレイを配置して暗転
			画面暗転中フラグ = 真
			「画面を暗くしました」を表示
		ここまで
	違えば、もし、選択項目ID == 「verbosity」ならば
		「読み上げ詳細設定を開きます」を表示
	違えば、もし、選択項目ID == 「tts_settings」ならば
		「テキスト読み上げ設定を開きます」を表示
	違えば、もし、選択項目ID == 「braille_display_settings」ならば
		「点字ディスプレイ設定を開きます」を表示
	違えば、もし、選択項目ID == 「helloreader_settings」ならば
		「Hello Reader の設定を開きます」を表示
	ここまで
ここまで

# ==============================================================================
# 6. キャンセル・閉じる処理
# ==============================================================================
●メニューキャンセル処理とは
	もし、メニュー表示中フラグ == 真ならば
		# オーバーレイダイアログを破棄
		メニュー表示中フラグ = 偽
		「メニューを閉じました」を表示
	ここまで
ここまで
