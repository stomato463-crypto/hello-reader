# ==============================================================================
# Hello Reader - .gitignore (プロ仕様・環境＆セキュリティ防衛設定)
# ==============================================================================

# 1. 環境固有・秘密情報（絶対コミット禁止）
local.properties
*.keystore
*.jks
.runner
.gitea
*.lock

# 2. ビルド成果物・一時ファイル
*.apk
*.aar
build/
**/build/
/app/build
/build
/app/release

# 3. ログ・一時ファイル
*.log
*.txt
*.py
*.back
.DS_Store

# 4. バックアップ・圧縮アーカイブファイル（USB保管用など）
*.tar
*.gz
*.zst
*.7z
*.zip
*.zpaq

# 5. IDE・開発ツール用の設定・キャッシュ
/.gradle
/.idea
/.kotlin
*.iml
/.natk

# 6. 外部プロジェクト・ツール・サウンドリソース除外
/talkback
/ayame
/hello-reader-sound
/study
tools/build_talkback.ps1
tools/TalkBack_Logcat.ps1
run-gitea-log.ps1
/tools/run-gitea.ps1
/tools/run-runner.ps1
app/src/main/res/raw/typo.ogg
app/src/main/res/raw/complete.ogg

# 7. チームワークマルチエージェントの一時作業フォルダ
.agents/explorer_*
.agents/kotlin_worker_*
.agents/nako3_worker_*
.agents/orchestrator_*
.agents/reviewer_*
.agents/sentinel_*
.agents/victory_auditor_*
.agents/ORIGINAL_REQUEST.md
